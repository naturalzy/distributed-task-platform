APP_NAME=Distributed Task Platform
ENVIRONMENT=local
DEBUG=true
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=task_user
MYSQL_PASSWORD=task_password
MYSQL_DATABASE=task_platform

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_BROKER_DB=1
REDIS_RESULT_DB=2

TASK_LEASE_SECONDS=10
TASK_HEARTBEAT_SECONDS=2
TASK_MAX_ATTEMPTS=3
TASK_RECOVERY_SCAN_SECONDS=1

CSV_UPLOAD_DIR=uploads
CSV_MAX_UPLOAD_BYTES=10485760
CSV_MAX_ROWS=100000
CSV_MAX_COLUMNS=200
